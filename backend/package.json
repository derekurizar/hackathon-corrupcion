{
  "name": "backend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.13.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --config ../eslint.config.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "zod": "^3.25.28",
    "mongodb": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.1",
    "eslint": "^9.28.0",
    "@eslint/js": "^9.28.0",
    "typescript-eslint": "^8.33.1",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3"
  }
}
