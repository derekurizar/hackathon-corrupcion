# Required — MongoDB Atlas connection string (SRV format)
MONGODB_URI=

# Required for story generation (Area 07)
# ANTHROPIC_API_KEY=
# OPUS_LEAD=

# Required for audio generation (Phase 2)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ES=
# ELEVENLABS_VOICE_EN=
# Narration speed — ElevenLabs voice_settings.speed (0.7–1.2, default 0.85 = slower)
# ELEVENLABS_SPEED=0.85

# Cost guard — max investigations to generate per run (default: 20)
MAX_INVESTIGATIONS_PER_RUN=20

# Generation prompt digest — bound the evidence the LLM sees per case.
# A "case" can hold tens of thousands of near-identical evidence rows; the
# prompt sends per-rule rollups + a money-ranked representative sample instead.
EVIDENCE_SAMPLE_PER_RULE=6
MAX_REPRESENTATIVE_EVIDENCE=60

# Floor for the evidence array stored on each Investigation document. The full
# flattened evidence can be tens of thousands of rows (>17 MB → MongoDB write
# crash); a locked-order prefix is persisted, auto-grown to cover any scenePlan
# ref so every ev:<i> still resolves on the SPA.
MAX_PERSISTED_EVIDENCE=300

# Per-rule cap on signals used for scene derivation + persisted on the doc.
# deriveFromEvidence flattens every signal's evidence; an uncapped case makes
# a multi-MB scenePlan that overflows MongoDB. Digest/dedup use the full set.
MAX_SCENE_SIGNALS_PER_RULE=8

# Stage toggles (default: all enabled)
RUN_BENCHMARKS=true
RUN_DETECTION=true
RUN_STORY=true
RUN_AUDIO=true
RUN_PUBLISH=true

# Shortcut: ingest only, skip all subsequent stages
INGEST_ONLY=false

# Brand config
BRAND_NAME=Expediente Público
BRAND_TAGLINE=

# Logging — structured logs (pino) go to stderr AND a per-run file.
# LOG_LEVEL: fatal|error|warn|info|debug|trace|silent (default: info)
LOG_LEVEL=info
# LOG_DIR: log + publish-artifact base dir.
# Default: ./logs (cwd) locally, /tmp/logs in Lambda.
# LOG_DIR=logs
# Dump each validated Investigation to <LOG_DIR>/publish/<runId>/ before the
# MongoDB upsert (default: true).
PUBLISH_ARTIFACTS=true

# Audio bucket for generated narration (Phase 2)
AUDIO_BUCKET=test

# Frontend SPA — API base URL (Vite VITE_ prefix = injected at build time, not in Node)
# Production: /api  (SPA and API are served from the same CloudFront domain;
#             CF behaviour routes /api/* → API Gateway, which strips the /api prefix)
# Local dev against the deployed API: https://<cf-domain>/api
# Local dev with Vite proxy: leave empty and configure server.proxy in vite.config.ts
VITE_API_BASE_URL=/api
