# Required — MongoDB Atlas connection string (SRV format)
MONGODB_URI=

# Required for story generation (Area 07)
# ANTHROPIC_API_KEY=

# Required for audio generation (Phase 2)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ES=
# ELEVENLABS_VOICE_EN=

# Cost guard — max investigations to generate per run (default: 20)
MAX_INVESTIGATIONS_PER_RUN=20

# Stage toggles (default: all enabled)
RUN_BENCHMARKS=true
RUN_DETECTION=true
RUN_STORY=true
RUN_AUDIO=true
RUN_PUBLISH=true

# Shortcut: ingest only, skip all subsequent stages
INGEST_ONLY=false

# Brand config
BRAND_NAME=Expediente Público
BRAND_TAGLINE=
