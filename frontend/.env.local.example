# Local development overrides — copy to .env.local (gitignored by Vite)
# Uncomment one of the following depending on your dev setup:

# Option A — point at the deployed CloudFront + API (requires cdk deploy to have run)
VITE_API_BASE_URL=https://<your-cf-domain>/api

# Option B — point at a local API server or mock (e.g. json-server on port 4000)
# VITE_API_BASE_URL=http://localhost:4000

# Option C — use Vite's built-in proxy (configure server.proxy in vite.config.ts)
# VITE_API_BASE_URL=
